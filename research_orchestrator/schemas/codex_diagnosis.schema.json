{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexDiagnosis",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "failure_class": {
      "type": "string",
      "enum": ["PASS_DEV", "FAIL_TIMING", "FAIL_CONTACT", "FAIL_WBC", "FAIL_PLANNER", "FAIL_SAFE_STOP", "RUNNER_FAILURE", "UNKNOWN"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "signal": {"type": "string", "minLength": 1, "maxLength": 120},
          "value": {"type": "string", "maxLength": 500}
        },
        "required": ["signal", "value"]
      }
    },
    "hypothesis": {"type": ["string", "null"], "maxLength": 2000},
    "recommended_action": {
      "type": "string",
      "enum": ["advance", "rerun", "collect_evidence", "checkpoint", "escalate", "stop"]
    },
    "recommended_profile": {
      "type": ["string", "null"],
      "enum": ["b0-development", "b0-holdout", "b1-probe", null]
    },
    "needs_human_review": {"type": "boolean"}
  },
  "required": ["failure_class", "summary", "confidence", "evidence", "hypothesis", "recommended_action", "recommended_profile", "needs_human_review"]
}
