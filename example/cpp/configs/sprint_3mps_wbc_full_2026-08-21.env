export TROT_HS_BASE_HEIGHT=0.34
export TROT_HS_STEP_CAP=0.52
export TROT_HS_START_PERIOD=0.20
export TROT_HS_START_DUTY=0.50
export TROT_HS_STEP_SLEW=0.010
export TROT_HS_SPEED_LEAD=0.30
export TROT_HS_RAMP_STEP=0.060
export TROT_HS_SWING_REACH=1.0
export TROT_HS_USE_VEL_TASK=0
export TROT_HS_USE_LEAN=1
export TROT_HS_PITCH_REF=0
export TROT_HS_PITCH_GAIN=12
export TROT_HS_PITCH_DAMP=3
export TROT_HS_PITCH_ACC_LIMIT=4
export TROT_HS_ROLL_GAIN=12
export TROT_HS_ROLL_DAMP=6
export TROT_HS_ROLL_ACC_LIMIT=8
export FULL2_W_ANG=180
export FULL2_W_LIN=90
export FULL2_W_SWING=100
export FULL2_W_SWING_X=160
