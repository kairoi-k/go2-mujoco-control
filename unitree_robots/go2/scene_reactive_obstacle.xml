<mujoco model="go2 reactive obstacle">
  <include file="go2.xml"/>

  <statistic center="0.5 0 0.18" extent="1.2"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-16"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.12"/>
    <material name="reactive_obstacle_red" rgba="0.85 0.08 0.03 1"/>
    <material name="reactive_obstacle_yellow" rgba="1 0.75 0.04 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Visual obstacle proxy; the scripted event supplies the trigger. -->
    <geom name="reactive_obstacle" pos="0.75 0 0.18" type="box" size="0.12 0.14 0.18" material="reactive_obstacle_red" contype="0" conaffinity="0"/>
    <geom name="reactive_obstacle_marker" pos="0.75 0 0.37" type="box" size="0.14 0.16 0.015" material="reactive_obstacle_yellow" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
