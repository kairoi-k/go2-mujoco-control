+void Simulate::PublishRenderSnapshot(const mjModel* model, const mjData* data) {
+  if (!is_passive_ || !model || !data) {
+    return;
+  }
+
+  // The caller normally is PhysicsLoop. Locking here also keeps model
+  // replacement ordered for other possible producers.
+  MutexLock physics_lock(this->mtx);
+  if (this->exitrequest.load() || model != this->m_ ||
+      !this->m_passive_ || !this->d_passive_ ||
+      this->state_size_ <= 0 ||
+      static_cast<int>(this->render_state_.size()) != this->state_size_) {
+    return;
+  }
+
+  // Never wait for rendering. A missed visual frame is preferable to
+  // delaying the 1 kHz control/data path.
+  std::unique_lock<std::mutex> render_lock(
+      this->render_mtx, std::try_to_lock);
+  if (!render_lock.owns_lock()) {
+    return;
+  }
+
+  mj_getState(model, data, this->render_state_.data(),
+              mjSTATE_INTEGRATION);
+  mj_setState(this->m_passive_, this->d_passive_,
+              this->render_state_.data(), mjSTATE_INTEGRATION);
+  mj_forward(this->m_passive_, this->d_passive_);
+}
 
